{
  "manifest_version": 3,
  "name": "ChatGPT Text Auto V1.1.1",
  "version": "1.1.1",
  "description": "Văn bản lặp, tạo ảnh CHAR/BG, và pipeline Pilot Tác Phẩm trên tab ChatGPT hiện tại.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "sidePanel",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ChatGPT Text Auto",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "pilot/lib/page-read.js",
        "pilot/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
